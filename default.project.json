{
  "name": "LastShift",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },
      "StarterCharacterScripts": {
        "$className": "StarterCharacterScripts",
        "Health": {
          "$path": "src/character/Health.server.luau"
        }
      },
      "$properties": {
        "CharacterWalkSpeed": 12,
        "EnableMouseLockOption": false
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0.1,
          0.11,
          0.13
        ],
        "OutdoorAmbient": [
          0.12,
          0.13,
          0.16
        ],
        "Brightness": 1,
        "ClockTime": 0,
        "FogEnd": 220,
        "FogColor": [
          0.05,
          0.06,
          0.08
        ],
        "Technology": "Voxel"
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.3,
          "Offset": 0.15,
          "Color": [
            0.36,
            0.4,
            0.46
          ],
          "Decay": [
            0.2,
            0.22,
            0.26
          ],
          "Glare": 0,
          "Haze": 1.2
        }
      },
      "ColorGrade": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": -0.02,
          "Contrast": 0.12,
          "Saturation": -0.3,
          "TintColor": [
            0.93,
            0.96,
            1
          ]
        }
      },
      "Glow": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.5,
          "Size": 20,
          "Threshold": 1.4
        }
      }
    },
    "ServerStorage": {
      "Props": {
        "$path": "assets/props"
      },
      "Maps": {
        "$path": "assets/maps"
      }
    }
  }
}
